{
  "name": "benday-workspace",
  "private": true,
  "homepage": "https://benday.kacemmathlouthi.dev",
  "bugs": {
    "url": "https://github.com/KacemMathlouthi/benday/issues"
  },
  "license": "MIT",
  "author": "Kacem Mathlouthi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KacemMathlouthi/benday.git"
  },
  "workspaces": [
    "apps/*",
    "registry"
  ],
  "type": "module",
  "scripts": {
    "build": "bun run registry:build && turbo run build",
    "dev": "bun run registry:build && turbo run dev",
    "typecheck": "turbo run typecheck",
    "registry:build": "shadcn build --output apps/web/public/r",
    "check": "ultracite check",
    "changeset": "changeset",
    "changeset:status": "changeset status --verbose",
    "fix": "ultracite fix",
    "knip": "knip",
    "release": "changeset tag",
    "video:render": "bun --cwd apps/launch-video run render",
    "video:still": "bun --cwd apps/launch-video run still",
    "video:studio": "bun --cwd apps/launch-video run dev",
    "version-packages": "changeset version",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/bun": "^1.3.9",
    "@types/react": "^19.2.18",
    "knip": "^5.66.1",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "react": "^19.2.8",
    "shadcn": "^4.16.2",
    "turbo": "^2.8.14",
    "typescript": "^5.9.3",
    "ultracite": "^7.1.4"
  },
  "overrides": {
    "//": "streamdown pulls shiki 4 while @streamdown/code pins shiki 3, and the two BundledLanguage unions do not unify. One copy keeps the ai-elements plugin config type-checking — and keeps a large dependency out of the bundle twice.",
    "shiki": "3.23.0"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "packageManager": "bun@1.3.9"
}
