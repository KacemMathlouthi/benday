{
  "name": "launch-video",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "remotion bundle src/index.ts --out-dir dist",
    "clean": "rm -rf dist out",
    "dev": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts BendayLaunch out/benday-launch.mp4 --codec h264 --muted --pixel-format yuv420p",
    "still": "remotion still src/index.ts BendayLaunch out/review.png --frame 1680",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@remotion/cli": "^4.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "typescript": "^5.9.3"
  }
}
